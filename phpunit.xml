<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!--
            Pinned to the domain root. A developer serving the app from a
            subdirectory (http://localhost/sortifya/public under XAMPP) sets
            APP_URL/ASSET_URL to match, and without these overrides every
            $this->get('/') would resolve to that path and 404.
        -->
        <env name="APP_URL" value="http://localhost"/>
        <env name="ASSET_URL" value=""/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            A dedicated MySQL schema, not sqlite in-memory: the platform leans
            on MySQL-specific behaviour (JSON_EXTRACT in the landing-page
            stats, SELECT ... FOR UPDATE in the claim path), and a test that
            runs on a different engine would not exercise it. Create it once:
                CREATE DATABASE sortifya_db_test;
        -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="sortifya_db_test"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
