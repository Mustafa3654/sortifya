APP_NAME=Sortifya
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC

# ── Where the app is served from ──────────────────────────────
# Behind `php artisan serve`, the default below is right and ASSET_URL stays
# empty.
#
# Serving it through XAMPP's Apache from htdocs puts the app in a
# SUBDIRECTORY. Set ASSET_URL to that base PATH — no scheme, no host:
#   ASSET_URL=/sortifya/public
#
# Path-only is deliberate. It emits root-relative asset URLs, so the same
# value works over http://localhost, over an https ngrok tunnel, and over any
# domain you point at the app later, with nothing to change per host.
#
# ASSET_URL is not optional there. Without it Livewire emits a root-relative
# "/livewire/livewire.js", which 404s outside the domain root — and since
# Filament's admin UI is Alpine-driven, that renders /admin as a blank page.
#
# APP_URL is only the fallback for URLs built outside a request (queued jobs,
# password-reset mail); during a web request Laravel follows the real host.
# Point it at the address people actually reach the app on.
APP_URL=http://localhost:8000
ASSET_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────
# XAMPP / MariaDB. Create `sortifya_db` in phpMyAdmin first.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sortifya_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# ── Mail: Brevo SMTP relay ────────────────────────────────────
# MAIL_USERNAME is the Brevo SMTP login (an address); MAIL_PASSWORD is the
# SMTP key from Brevo → SMTP & API, not your account password.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@sortifya.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Contact form ──────────────────────────────────────────────
# CONTACT_TO is the inbox that receives messages from /contact. Mail is sent
# FROM MAIL_FROM_ADDRESS with Reply-To set to the visitor, so hitting reply
# answers them — a relay will not send mail claiming to be a stranger's
# address, and MAIL_FROM_ADDRESS must be a sender you verified in Brevo.
#
# Every message is also stored and visible in /admin, so nothing is lost if
# mail fails. Leave CONTACT_TO empty and it falls back to MAIL_FROM_ADDRESS.
CONTACT_TO=
CONTACT_SUPPORT_EMAIL=
CONTACT_SUPPORT_PHONE=
CONTACT_RESPONSE_HOURS=24

# ── Who operates the platform (printed in the legal pages) ────
COMPANY_LEGAL_NAME=Sortifya
COMPANY_COUNTRY=Lebanon
COMPANY_ADDRESS=
LEGAL_UPDATED=2026-08-01

# ── Telegram payout alerts ────────────────────────────────────
# Create a bot with @BotFather, then register the webhook at
#   POST {APP_URL}/api/telegram/webhook
# passing the same secret_token you set here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# ── Platform rules ────────────────────────────────────────────
SORTIFYA_TASK_HOLD_MINUTES=45
SORTIFYA_MAX_CONCURRENT_TASKS=1
SORTIFYA_MIN_WITHDRAWAL=10.00
SORTIFYA_MAX_UPLOAD_KB=10240
SORTIFYA_PREVIEW_ROWS=10

VITE_APP_NAME="${APP_NAME}"
