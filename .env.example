APP_NAME=Sortifya
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────
# XAMPP / MariaDB. Create `sortifya_db` in phpMyAdmin first.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sortifya_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# ── Mail: Brevo SMTP relay ────────────────────────────────────
# MAIL_USERNAME is the Brevo SMTP login (an address); MAIL_PASSWORD is the
# SMTP key from Brevo → SMTP & API, not your account password.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@sortifya.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Telegram payout alerts ────────────────────────────────────
# Create a bot with @BotFather, then register the webhook at
#   POST {APP_URL}/api/telegram/webhook
# passing the same secret_token you set here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# ── Platform rules ────────────────────────────────────────────
SORTIFYA_TASK_HOLD_MINUTES=45
SORTIFYA_MAX_CONCURRENT_TASKS=1
SORTIFYA_MIN_WITHDRAWAL=10.00
SORTIFYA_MAX_UPLOAD_KB=10240
SORTIFYA_PREVIEW_ROWS=10

VITE_APP_NAME="${APP_NAME}"
